# Waikiki Dental — client-side form configuration
#
# Both forms submit to the public Formspree endpoint in src/lib/forms.ts
# (https://formspree.io/f/xeajvpnb). Set the variable below to a dedicated
# Formspree form to separate contact messages from appointment requests. Only
# an exact https://formspree.io/f/<form-id> URL is accepted; blank or malformed
# values safely fall back to the canonical endpoint.
# Form IDs are public; never place Formspree account tokens or private
# credentials in a NEXT_PUBLIC_ value.

NEXT_PUBLIC_FORMSPREE_CONTACT_ENDPOINT=

# Turn on only after Web Analytics is enabled for the Vercel project. The
# client strips query strings, groups service and appointment paths, and
# excludes /privacy-practices before sending a page view.
VERCEL_WEB_ANALYTICS_ENABLED=
