# Waikiki Dental — planned Formspree configuration
#
# The forms are frontend-only until these endpoints are created and the form
# components are wired to submit to them. Form IDs are public; never place
# Formspree account tokens or other private credentials in NEXT_PUBLIC_ values.

NEXT_PUBLIC_FORMSPREE_CONTACT_ENDPOINT=
NEXT_PUBLIC_FORMSPREE_APPOINTMENT_ENDPOINT=
