# Waikiki Dental — client-side form configuration
#
# Both forms submit to public Formspree endpoints. The appointment form's
# endpoint is configured in src/components/appointment-scheduler.tsx. The
# contact form shares that endpoint by default; set the variable below to a
# dedicated Formspree form to separate contact messages from appointment
# requests. Form IDs are public; never place Formspree account tokens or
# private credentials in a NEXT_PUBLIC_ value.

NEXT_PUBLIC_FORMSPREE_CONTACT_ENDPOINT=
