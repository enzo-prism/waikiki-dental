# Waikiki Dental — client-side form configuration
#
# The appointment form's public endpoint is intentionally configured in
# src/components/appointment-scheduler.tsx. The contact form remains
# frontend-only. The reserved variable below has no runtime effect until the
# contact form submission implementation is added. Form IDs are public; never
# place Formspree account tokens or private credentials in a NEXT_PUBLIC_ value.

NEXT_PUBLIC_FORMSPREE_CONTACT_ENDPOINT=
